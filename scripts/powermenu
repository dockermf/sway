#!/usr/bin/env bash

woficmd="wofi -bd --width=600 --height=180"
woficonfirm="wofi -bd --width=600 --height=131"

confirm() {
    answer=$(printf 'yes\nno' | $woficonfirm -p 'u sure?')
    [[ $answer == "yes" ]] && return 0 || return 1
}

notify() {
    notify-send "$@"
}

open_menu() {
    opts='poweroff\nreboot\nsuspend'
    choice=$(printf $opts | $woficmd -p 'Power menu')

    [[ -z $choice ]] && exit 0

    case $choice in
        'poweroff')
            if confirm; then
                notify "Powering off"
                sleep 2
                systemctl poweroff
            fi
            ;;
        'reboot')
            if confirm; then
                notify "Rebooting"
                sleep 2
                systemctl reboot
            fi
            ;;
        'suspend')
            if confirm; then
                notify "Suspending"
                sleep 2
                systemctl suspend
            fi
            ;;
    esac
}

if ! pgrep -xf 'wofi -bd --width=600 --height=180 -p Power menu'; then
    open_menu
fi
